# 腾讯云 COS 部署配置（复制本文件为 cos.env 后填写）
#
# 1. API 密钥：https://console.cloud.tencent.com/cam/capi
COS_SECRET_ID=
COS_SECRET_KEY=

# 2. 存储桶（含 APPID 后缀，形如 gpu-card-calculator-1234567890）
#    https://console.cloud.tencent.com/cos/bucket
COS_BUCKET=

# 3. 地域代码（上海 ap-shanghai / 广州 ap-guangzhou / 北京 ap-beijing）
COS_REGION=ap-shanghai
